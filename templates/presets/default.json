{
  "variance": 5,
  "density": 7,
  "motion": 4,
  "desc": "Balanced modern SaaS baseline (Neutral Zinc)",
  "colors": {
    "background": {
      "primary": "#09090b",
      "secondary": "#121215",
      "surface": "#18181b"
    },
    "text": {
      "primary": "#fafafa",
      "secondary": "#a1a1aa",
      "muted": "#71717a"
    },
    "accent": {
      "primary": "#2563eb",
      "hover": "#1d4ed8"
    },
    "border": {
      "subtle": "#18181b",
      "default": "#27272a",
      "strong": "#3f3f46"
    },
    "status": {
      "success": "#22c55e",
      "warning": "#eab308",
      "error": "#ef4444",
      "info": "#3b82f6"
    }
  },
  "typography": {
    "imports": [
      "https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css",
      "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap"
    ],
    "families": {
      "display": ["Space Grotesk", "Pretendard", "sans-serif"],
      "body": ["Pretendard", "-apple-system", "BlinkMacSystemFont", "system-ui", "sans-serif"],
      "mono": ["JetBrains Mono", "Consolas", "monospace"]
    }
  }
}
