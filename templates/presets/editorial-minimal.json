{
  "variance": 8,
  "density": 3,
  "motion": 5,
  "desc": "Airy asymmetric showcase & publication (Warm Paper & Vermilion)",
  "colors": {
    "background": {
      "primary": "#f8f7f4",
      "secondary": "#f1efe9",
      "surface": "#ffffff"
    },
    "text": {
      "primary": "#18181b",
      "secondary": "#52525b",
      "muted": "#8a8a93"
    },
    "accent": {
      "primary": "#c2410c",
      "hover": "#9a3412"
    },
    "border": {
      "subtle": "#edeae2",
      "default": "#e2ddd3",
      "strong": "#c8c1b2"
    },
    "status": {
      "success": "#15803d",
      "warning": "#b45309",
      "error": "#b91c1c",
      "info": "#1d4ed8"
    }
  },
  "typography": {
    "imports": [
      "https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css",
      "https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&display=swap"
    ],
    "families": {
      "display": ["Newsreader", "Pretendard", "Georgia", "serif"],
      "body": ["Pretendard", "-apple-system", "BlinkMacSystemFont", "system-ui", "sans-serif"],
      "mono": ["JetBrains Mono", "Consolas", "monospace"]
    }
  }
}
